generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  VIP
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String        @id @default(uuid())
  discordId       String        @unique
  discordUsername String
  discordAvatar   String?
  ucpName         String
  socialNickname  String
  role            Role          @default(USER)
  vipUntil        DateTime?
  isBlocked       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  profile         Profile?
  sentLikes       Like[]        @relation("SentLikes")
  receivedLikes   Like[]        @relation("ReceivedLikes")
  matchesA        Match[]       @relation("MatchA")
  matchesB        Match[]       @relation("MatchB")
  messages        Message[]
  visitsMade      ProfileVisit[] @relation("VisitsMade")
  visitsReceived  ProfileVisit[] @relation("VisitsReceived")
  payments        Payment[]
  reportsMade     Report[]      @relation("ReportsMade")
  reportsReceived Report[]      @relation("ReportsReceived")
  adminActions    AdminAction[]
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  age       Int?
  gender    Gender?
  city      String?
  bio       String?
  interests String[] @default([])
  hidden    Boolean  @default(false)
  photos    Photo[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Photo {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean  @default(false)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Like {
  id        String   @id @default(uuid())
  fromUserId String
  toUserId   String
  fromUser   User    @relation("SentLikes", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User    @relation("ReceivedLikes", fields: [toUserId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([fromUserId, toUserId])
}

model Match {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  userA     User     @relation("MatchA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("MatchB", fields: [userBId], references: [id], onDelete: Cascade)
  chat      Chat?
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
}

model Chat {
  id        String    @id @default(uuid())
  matchId   String    @unique
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id        String   @id @default(uuid())
  chatId    String
  senderId  String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  message   String
  attachmentUrl String?
  readAt    DateTime?
  createdAt DateTime @default(now())
}

model ProfileVisit {
  id        String   @id @default(uuid())
  visitorId String
  targetId  String
  visitor   User     @relation("VisitsMade", fields: [visitorId], references: [id], onDelete: Cascade)
  target    User     @relation("VisitsReceived", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Payment {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  note      String?
  status    PaymentStatus @default(PENDING)
  approvedBy String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Report {
  id        String   @id @default(uuid())
  reporterId String
  targetId   String
  reporter   User    @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  target     User    @relation("ReportsReceived", fields: [targetId], references: [id], onDelete: Cascade)
  reason     String
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model AdminAction {
  id        String   @id @default(uuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}
